# Copy to .env (cp .env.example .env). Defaults match docker-compose.yml.
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://payments:payments@localhost:5432/payments?schema=public

KAFKA_CLIENT_ID=payments-service
KAFKA_BROKERS=localhost:9092
PAYMENT_CREATED_TOPIC=payment-created

# Optional: verify against a Pact Broker instead of the local ./pacts folder
# PACT_BROKER_BASE_URL=https://your-org.pactflow.io
# PACT_BROKER_TOKEN=
